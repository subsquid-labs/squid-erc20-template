DB_NAME=squid
DB_PORT=23798
GQL_PORT=4350

CONTRACT_ADDRESS=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
CONTRACT_DEPLOYED_AT=6082465

# JSON-RPC node endpoint (wss or https). Block data is streamed from the SQD Network
# Portal, so an RPC is only needed here to read token metadata from the contract state.
# Use private endpoints in production!
# Set urls via secrets if deploying to Cloud: https://docs.sqd.dev/en/cloud/reference/env-variables
RPC_ENDPOINT=https://rpc.ankr.com/eth

# Uncommenting this line enables the debug mode
# More info at https://docs.sqd.dev/en/sdk/how-to-start/logging
#SQD_DEBUG=*
